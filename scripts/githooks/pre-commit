#!/bin/bash
# FinSight git pre-commit 훅.
#
# CLAUDE.md의 CRITICAL 규칙 중 **텍스트만 보고 확정할 수 있는 것**만 본다.
# LLM 리뷰(`/review-code`)가 하는 일을 여기서 하지 않는다. 이유: 리뷰의 단위는
# merge-base(main)..HEAD 브랜치 전체이고 에이전트 7개에 수 분이 걸린다. 커밋은 하루에
# 수십 번 일어난다. 단위도 비용도 맞지 않는다. LLM 리뷰는 PR에서 GitHub Actions가 돌린다.
#
# 검사 대상은 **스테이지된 추가 줄**뿐이다. 이미 리포에 있던 코드로 남의 커밋을 막으면
# 훅은 첫날부터 --no-verify로 우회되고, 그 순간 잡던 것도 같이 못 잡게 된다.
#
# 설치: git config core.hooksPath scripts/githooks
# 테스트: bash scripts/githooks/test-pre-commit.sh

set -u

# ── 검사에서 빼는 경로 ──────────────────────────────────────────────────────
# 테스트·문서·훅 자신은 규칙 문자열을 인용할 수밖에 없다. 훅이 자기 자신을 막으면
# 훅을 고칠 수가 없다.
EXCLUDE='(\.test\.|\.spec\.|__tests__/|^scripts/|^docs/|\.md(:|$)|^\.github/|^\.claude/|^\.codex/)'

# ── 스테이지된 추가 줄을 "경로:줄번호:내용" 으로 뽑는다 ─────────────────────
# `diff --git`부터 첫 `@@`까지가 헤더 구역이다. 그 밖의 `+++ `는 내용이 '++ '로 시작하는
# 추가된 줄이지 파일 헤더가 아니다. 구별하지 않으면 그 줄에서 파일명이 바뀌어 뒤따르는
# 지적이 통째로 엉뚱한 파일에 붙는다. (scripts/pr_review_payload.py가 같은 함정을 다룬다.)
ADDED=$(git diff --cached -U0 --diff-filter=ACMR | awk '
  /^diff --git / { inhdr = 1; next }
  inhdr && /^\+\+\+ / {
    if ($0 == "+++ /dev/null") { file = "" } else { file = substr($0, 7) }
    next
  }
  /^@@ / {
    inhdr = 0
    split($0, a, "+"); split(a[2], b, /[ ,]/); ln = b[1] + 0
    next
  }
  /^\+/ {
    if (file == "") next
    body = substr($0, 2)
    # 주석 줄은 코드가 아니다. 규칙을 적어 둔 주석("dangerouslySetInnerHTML을 쓰지 않는다")이
    # 그 규칙에 걸려 커밋을 막으면, 훅은 그날로 --no-verify로 우회된다. 실제로 이 리포의
    # InsightPanel.tsx·claude.ts 주석 두 줄이 그렇게 걸렸다.
    # CSS의 `#id` 선택자와 TS의 private 필드 `#x`를 죽이지 않으려 `#`는 주석으로 보지 않는다.
    if (body !~ /^[[:space:]]*(\/\/|\*|\/\*)/) { print file ":" ln ":" body }
    ln++
  }
' | grep -Ev "$EXCLUDE")

FOUND=0

# report <규칙> <설명> <걸린 줄들>
report() {
  FOUND=$((FOUND + 1))
  printf '\n  [%s] %s\n' "$1" "$2" >&2
  printf '%s\n' "$3" | sed 's/^/    /' >&2
}

# check <규칙> <설명> <경로 정규식|""> <내용 정규식> [내용 정규식 2]
# 경로 정규식이 비면 모든 파일이 대상이다. 정규식 2를 주면 두 조건을 모두 만족하는 줄만 본다.
check() {
  local rule=$1 desc=$2 paths=$3 pat=$4 pat2=${5:-}
  local hits=$ADDED
  [ -n "$paths" ] && hits=$(printf '%s\n' "$hits" | grep -E "$paths")
  hits=$(printf '%s\n' "$hits" | grep -E "$pat")
  # 2차 패턴은 **내용에만** 건다. 줄이 "경로:줄:내용" 형태라 그냥 걸면 파일 경로에
  # transaction·amount가 들어 있다는 이유로 멀쩡한 로그가 걸린다(src/lib/transaction-parser.ts).
  # `^[^:]+:[0-9]+:` 가 접두사를 정확히 먹고, 패턴은 그 뒤에서만 찾는다.
  [ -n "$pat2" ] && hits=$(printf '%s\n' "$hits" | grep -E "^[^:]+:[0-9]+:.*($pat2)")
  [ -z "$hits" ] && return 0
  report "$rule" "$desc" "$hits"
}

# ① 서버 전용 비밀키에 NEXT_PUBLIC_ 접두사. 클라이언트 번들에 들어가면 즉시 유출이다.
#    src 밖(next.config.ts 등)에서도 똑같이 새므로 경로를 제한하지 않는다.
check "비밀키" \
  "서버 전용 키에 NEXT_PUBLIC_ 접두사가 붙었습니다. 클라이언트 번들에 들어가면 즉시 유출입니다." \
  "" \
  'NEXT_PUBLIC_[A-Z0-9_]*(API_KEY|SERVICE_ROLE|ACCESS_TOKEN|WEBHOOK_SECRET|SECRET)'

# ② LLM 출력에는 사용자가 올린 CSV에서 온 임의 문자열이 섞인다. React 기본 이스케이프가
#    유일한 XSS 방어선이다.
check "XSS" \
  "dangerouslySetInnerHTML은 쓰지 않습니다. LLM 출력에 사용자 CSV 문자열이 섞입니다." \
  '^src/' \
  'dangerouslySetInnerHTML'

# ③ 금융 데이터를 로그에 남기지 않는다. Vercel 함수 로그도 유출 경로다.
check "금융 데이터" \
  "거래 내용·가맹점명·금액을 로그에 남기지 않습니다. 행 내용 대신 행 번호만 남기세요." \
  '^src/' \
  'console\.(log|info|debug|warn|error|table|dir)\(' \
  '(merchant|amount|transaction|payee|가맹점|금액|거래)'

# ④ 금액은 원 단위 정수로만 다룬다.
check "부동소수점" \
  "금액은 원 단위 정수로만 다룹니다. parseFloat·toFixed는 쓰지 않습니다." \
  '^src/(lib|services|app/api)/' \
  '(parseFloat|Number\.parseFloat|\.toFixed\()'

# ⑤ 라틴 타이포 관용구는 한글에서 효과가 없거나 깨져 보인다.
check "타이포" \
  "한글에 uppercase·tracking-tight·tracking-wide·font-light를 쓰지 않습니다." \
  '^src/[^:]*\.(tsx|css):' \
  '(^|[^-a-z])(uppercase|tracking-tight|tracking-wide|font-light)([^-a-z]|$)'

# ⑥ 클라이언트 컴포넌트에서 서버 전용 env 참조. ①과 달리 이름만으로는 알 수 없고
#    파일이 'use client'인지 봐야 하므로 파일 단위로 따로 돈다.
CLIENT_HITS=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    src/*.ts | src/*.tsx | src/*/*.ts | src/*/*.tsx | src/*/*/*.ts | src/*/*/*.tsx | \
    src/*/*/*/*.ts | src/*/*/*/*.tsx | src/*/*/*/*/*.ts | src/*/*/*/*/*.tsx) ;;
    *) continue ;;
  esac
  git show ":$f" 2>/dev/null | head -5 | grep -qE "^[[:space:]]*['\"]use client['\"]" || continue
  hits=$(printf '%s\n' "$ADDED" | awk -v f="$f:" 'index($0, f) == 1' \
    | grep -E 'process\.env\.[A-Z0-9_]+' | grep -vE 'process\.env\.(NEXT_PUBLIC_|NODE_ENV)')
  # NODE_ENV는 Next가 빌드 타임에 치환하는 공개 값이라 클라이언트에서 정상이다.
  [ -n "$hits" ] && CLIENT_HITS="${CLIENT_HITS}${hits}"$'\n'
done <<EOF
$(git diff --cached --name-only --diff-filter=ACMR | grep -Ev "$EXCLUDE")
EOF

if [ -n "$(printf '%s' "$CLIENT_HITS" | tr -d '[:space:]')" ]; then
  report "서버 경계" \
    "클라이언트 컴포넌트에서 서버 전용 env를 참조했습니다. 서버 라우트나 Server Component로 옮기세요." \
    "$(printf '%s' "$CLIENT_HITS" | grep -v '^$')"
fi

# ── 판정 ────────────────────────────────────────────────────────────────────
if [ "$FOUND" -gt 0 ]; then
  printf '\n✗ 커밋을 중단했습니다 — CLAUDE.md CRITICAL 규칙 위반 %s종\n' "$FOUND" >&2
  printf '\n고친 뒤 다시 커밋하세요. 규칙이 잘못 걸렸다고 판단되면 `git commit --no-verify`로 넘길 수 있습니다.\n' >&2
  exit 1
fi

exit 0
